<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTrackerApp.ViewModels"
             xmlns:models="clr-namespace:ExpenseTrackerApp.Models"
             x:Class="ExpenseTrackerApp.Views.AccountsPage"
             x:DataType="vm:AccountsViewModel"
             Title="กระเป๋าเงิน">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="บัญชีเงินสด/ธนาคาร" Style="{StaticResource TitleLabel}" FontSize="14" />
                <Label Grid.Column="1" Text="+ เพิ่มบัญชี" TextColor="{StaticResource AccentOrange}" FontSize="12" />
            </Grid>

            <CollectionView ItemsSource="{Binding CashAccounts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Account">
                        <Frame Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0" Text="🏦" FontSize="18" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding OpeningBalance, StringFormat='฿{0:N0}'}" VerticalOptions="Center" FontAttributes="Bold" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="บัตรเครดิต / สินเชื่อ" Style="{StaticResource TitleLabel}" FontSize="14" Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding CreditAccounts}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Account">
                        <Frame Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0" Text="💳" FontSize="18" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding CreditLimitRemaining, StringFormat='วงเงินคงเหลือ ฿{0:N0}'}" VerticalOptions="Center" TextColor="{StaticResource ExpenseRed}" FontAttributes="Bold" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="ผ่อนชำระ" Style="{StaticResource TitleLabel}" FontSize="14" Margin="0,10,0,0" />

            <CollectionView ItemsSource="{Binding InstallmentPlans}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:InstallmentPlan">
                        <Frame Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0" Text="{Binding IconEmoji}" FontSize="18" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding RemainingBalance, StringFormat='฿{0:N0}'}" VerticalOptions="Center" TextColor="{StaticResource ExpenseRed}" FontAttributes="Bold" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
