<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTrackerApp.ViewModels"
             x:Class="ExpenseTrackerApp.Views.BudgetPage"
             x:DataType="vm:BudgetViewModel"
             Title="งบประมาณ">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="10">

            <Label Text="{Binding Title}" Style="{StaticResource TitleLabel}" />

            <CollectionView ItemsSource="{Binding Lines}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:BudgetLine">
                        <Frame Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <VerticalStackLayout Spacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Label Grid.Column="0" Text="{Binding Icon}" FontSize="16" />
                                    <Label Grid.Column="1" Text="{Binding CategoryName}" Margin="8,0,0,0" />
                                    <Label Grid.Column="2">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Spent, StringFormat='฿{0:N0}'}" />
                                                <Span Text=" / " />
                                                <Span Text="{Binding Limit, StringFormat='฿{0:N0}'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>
                                <ProgressBar Progress="{Binding PercentUsed}" ProgressColor="{StaticResource AccentOrange}" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
