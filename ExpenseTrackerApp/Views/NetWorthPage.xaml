<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTrackerApp.ViewModels"
             x:Class="ExpenseTrackerApp.Views.NetWorthPage"
             x:DataType="vm:NetWorthViewModel"
             Title="ทรัพย์สินสุทธิ">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout>
                    <Label Text="ทรัพย์สินสุทธิ" Style="{StaticResource SubtitleLabel}" />
                    <Label Text="{Binding NetWorth, StringFormat='฿{0:N2}'}" FontSize="26" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

            <Label Text="ทรัพย์สิน" Style="{StaticResource TitleLabel}" FontSize="14" />
            <CollectionView ItemsSource="{Binding Assets}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountLine">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                            <Label Grid.Column="0" Text="{Binding Name}" />
                            <Label Grid.Column="1" Text="{Binding Amount, StringFormat='฿{0:N0}'}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="หนี้สิน" Style="{StaticResource TitleLabel}" FontSize="14" Margin="0,10,0,0" />
            <CollectionView ItemsSource="{Binding Liabilities}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountLine">
                        <Grid ColumnDefinitions="*,Auto" Padding="0,4">
                            <Label Grid.Column="0" Text="{Binding Name}" />
                            <Label Grid.Column="1" Text="{Binding Amount, StringFormat='฿{0:N0}'}" TextColor="{StaticResource ExpenseRed}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
