<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTrackerApp.ViewModels"
             x:Class="ExpenseTrackerApp.Views.OverviewPage"
             x:DataType="vm:OverviewViewModel"
             Title="ภาพรวม">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="{Binding Title}" Style="{StaticResource TitleLabel}" />

            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="ยอดคงเหลือรวม" Style="{StaticResource SubtitleLabel}" />
                    <Label Text="฿184,320" FontSize="30" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,10,0,0">
                        <Frame Grid.Column="0" BackgroundColor="#EAF3DE" Padding="10" CornerRadius="14" HasShadow="False">
                            <VerticalStackLayout>
                                <Label Text="รายรับ" FontSize="10" TextColor="#27500A" />
                                <Label Text="{Binding TotalIncome, StringFormat='฿{0:N0}'}" FontSize="15" FontAttributes="Bold" TextColor="#173404" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Column="1" BackgroundColor="#FAECE7" Padding="10" CornerRadius="14" HasShadow="False">
                            <VerticalStackLayout>
                                <Label Text="รายจ่าย" FontSize="10" TextColor="#712B13" />
                                <Label Text="{Binding TotalExpense, StringFormat='฿{0:N0}'}" FontSize="15" FontAttributes="Bold" TextColor="#4A1B0C" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Label Text="ธุรกรรมล่าสุด" Style="{StaticResource TitleLabel}" FontSize="14" />

            <CollectionView ItemsSource="{Binding CategorySummaries}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:CategorySummary">
                        <Frame Style="{StaticResource CardStyle}" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Label Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Name}" Margin="10,0,0,0" VerticalOptions="Center" TextColor="{StaticResource TextPrimary}" />
                                <Label Grid.Column="2" Text="{Binding Amount, StringFormat='฿{0:N0}'}" VerticalOptions="Center" TextColor="{StaticResource ExpenseRed}" FontAttributes="Bold" />
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
