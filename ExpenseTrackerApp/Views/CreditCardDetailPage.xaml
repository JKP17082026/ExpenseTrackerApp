<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpenseTrackerApp.ViewModels"
             x:Class="ExpenseTrackerApp.Views.CreditCardDetailPage"
             x:DataType="vm:CreditCardDetailViewModel"
             Title="{Binding Account.Name}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="รอบบิลปัจจุบัน" Style="{StaticResource SubtitleLabel}" />
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding CycleStart, StringFormat='{0:d MMM}'}" />
                                <Span Text=" – " />
                                <Span Text="{Binding CycleEnd, StringFormat='{0:d MMM}'}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <ProgressBar Progress="{Binding CycleProgressPercent}" ProgressColor="#AFA9EC" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="ยอดใช้จ่ายรอบนี้" Style="{StaticResource SubtitleLabel}" />
                    <Label Text="{Binding StatementBalance, StringFormat='฿{0:N0}'}" FontSize="26" FontAttributes="Bold" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,8,0,0">
                        <Frame Grid.Column="0" Style="{StaticResource CardStyle}" BackgroundColor="#F5F5F5">
                            <VerticalStackLayout>
                                <Label Text="ยอดเต็ม" Style="{StaticResource SubtitleLabel}" />
                                <Label Text="{Binding StatementBalance, StringFormat='฿{0:N0}'}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Frame>
                        <Frame Grid.Column="1" Style="{StaticResource CardStyle}" BackgroundColor="#F5F5F5">
                            <VerticalStackLayout>
                                <Label Text="ขั้นต่ำ" Style="{StaticResource SubtitleLabel}" />
                                <Label Text="{Binding MinimumPayment, StringFormat='฿{0:N0}'}" FontAttributes="Bold" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardStyle}" BackgroundColor="#FFF3D6">
                <VerticalStackLayout Spacing="4">
                    <Label Text="⚠️ ถ้าจ่ายแค่ขั้นต่ำ" FontAttributes="Bold" TextColor="#7A5222" />
                    <Label Text="{Binding EstimatedInterestIfMinimum, StringFormat='ประเมินดอกเบี้ยสะสม ~฿{0:N0} ก่อนวันครบกำหนดชำระ'}" FontSize="12" TextColor="#7A5222" />
                </VerticalStackLayout>
            </Frame>

            <Frame Style="{StaticResource CardStyle}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="วันครบกำหนดชำระ" Style="{StaticResource SubtitleLabel}" />
                    <Label Text="{Binding PaymentDueDate, StringFormat='{0:d MMMM yyyy}'}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
